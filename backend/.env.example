# Copy this file to .env and fill in your values
# For Render: set these as Environment Variables in the dashboard

NODE_ENV=production
PORT=8000

# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/fleetpro?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@YOUR_CLUSTER.mongodb.net/fleetpro?retryWrites=true&w=majority

# JWT Secret - use a long random string (Render can auto-generate this)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# Super Admin credentials
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=YourStrongPassword@2024

# Allowed frontend origins (your Render service URL)
# Example: https://fleetpro-api.onrender.com
FRONTEND_URL=https://YOUR-APP.onrender.com

# Gemini AI API Key — used for Smart Paste challan parsing
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyAxAATHx_1M1jTnZEgSGH7w6VVP0zVYitE
